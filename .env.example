# Copy to .env.local for development. Every variable is optional; the site
# runs with placeholders when they are unset.

# Absolute origin for metadata (canonical / Open Graph URLs). Set in Vercel.
NEXT_PUBLIC_SITE_URL=

# "on" enables Vercel Analytics and the landing page's custom events. Leave unset until launch.
NEXT_PUBLIC_ANALYTICS=

# Intake provider (src/lib/intake). "console" logs a masked line; add real providers there.
INTAKE_PROVIDER=console

# Landing page: "1" lets a production build through while <Unverified> claims remain (previews only).
ALLOW_UNVERIFIED=

# Community feed (src/lib/social). Long-lived Instagram token for the professional account whose
# posts the site shows; refresh at least monthly with `node scripts/instagram-token.mjs refresh`.
INSTAGRAM_ACCESS_TOKEN=
# Optional: handle shown in "Follow" links (defaults to the username the API returns).
INSTAGRAM_HANDLE=
# Optional: API base, for a different Graph API version or a local mock. Default graph.instagram.com/v23.0
INSTAGRAM_GRAPH_URL=
